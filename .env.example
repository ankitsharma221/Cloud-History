# Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ── AWS ──────────────────────────────────────────────────────
# Leave blank if using moto (fake AWS) for local development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# ── GitHub ───────────────────────────────────────────────────
# Personal access token with read:repo scope.
# Leave blank if using seed data.
GITHUB_TOKEN=

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev. Swap to postgresql:// for production.
DATABASE_URL=sqlite:///./archaeologist.db

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── IBM / watsonx (optional — only needed for ICA agent) ─────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
